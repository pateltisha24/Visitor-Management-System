# ---- server environment ----
# Copy this file to ".env" and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string (the same DB the Python CV layer writes to).
# Format: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign/verify JWTs. Use a long random string.
JWT_SECRET_KEY=

# Port for local dev (Vercel ignores this).
PORT=5000

# Comma-separated list of allowed client origins in production (CORS).
# CLIENT_URL=https://your-client.vercel.app

# Shared secret for the CV pipeline's POST /api/ingest endpoint.
# Must match VMS_INGEST_API_KEY in model/.env. Leave unset to disable ingestion.
INGEST_API_KEY=

# ---- AI insights (BYOK) ----
# Default provider key (Groq free tier) used when a user hasn't set their own.
GROQ_API_KEY=
# Secret used to encrypt users' stored BYOK keys at rest (any long random string).
AI_ENC_SECRET=

# ---- Retention / scheduled rollups ----
# If set, raw readings auto-expire after this many days (TTL index).
# RETENTION_DAYS=90
# Secret for the Vercel Cron rollup endpoint (Vercel sends it as a Bearer token).
CRON_SECRET=

# ---- FaceSense CV pipeline environment ----
# Copy this file to "model/.env" and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string (same DB the web dashboard reads from).
MONGODB_URI=

# Optional overrides (sensible defaults exist in config.py):
# VMS_DB_NAME=test
# VMS_COLLECTION=client1
# VMS_WRITE_INTERVAL=8

# RTSP/CCTV stream URL (for: python pipeline.py --source rtsp).
# Example: rtsp://<user>:<password>@<camera-ip>:<port>/<path>
RTSP_URL=

# ---- Analysis / performance ----
# VMS_ENGINE=deepface          # "deepface" (better) or "opencv" (lighter/faster)
# VMS_ANALYZE_EVERY=5          # analyse every Nth frame (higher = faster, fewer samples)
# VMS_MAX_SAMPLES=7            # samples per visitor before locking in the modal result

# ---- Storage ----
# VMS_STORAGE=mongo            # "mongo" (direct) or "http" (POST to the API)
# VMS_INGEST_URL=https://<server>/api/ingest
# VMS_INGEST_API_KEY=          # must match INGEST_API_KEY on the server

# ---- Live demo / multi-camera (see docs/DEMO.md) ----
# VMS_PROFILE=default          # "default" (accuracy) or "demo" (visitors appear within ~1-2 s)
# VMS_CAMERA_ID=main           # short id per camera; run one pipeline process per camera
# VMS_CAMERA_NAME=Main camera
# VMS_PREVIEW=false            # let the dashboard watch this camera's annotated feed (never stored)
# VMS_PREVIEW_FPS=8
# VMS_LIVE_URL=                # defaults to VMS_INGEST_URL's host + /ws/agent
# VMS_REID=false               # same-day re-identification (DeepFace engine only)
